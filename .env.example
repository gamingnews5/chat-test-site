# Required. Read the Zen key from KeePass: API Keys/Zen/API Key
OPENCODE_API_KEY=

# The site password (Igor's GENERIC_PASSWORD).
GENERIC_PASSWORD=

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GATE_COOKIE_SECRET=

# Optional
PORT=8810
HOST=127.0.0.1
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
DEFAULT_MODEL=deepseek-v4.1-flash
GATE_SESSION_DAYS=30
COOKIE_SECURE=true
